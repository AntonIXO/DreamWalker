# Author-time credentials for the `lord` CLI.
#
# These are read by tools/lord/* only, which runs under bun on the Lord's machine.
# NEVER prefix any of these with VITE_ — Vite inlines VITE_* variables into the
# client bundle, which would publish the key to every player who loads the dream.

# Retro Diffusion — pixel art generation (https://api.retrodiffusion.ai/v1)
# Used at author time to produce tile candidates. Unused until the art seam is filled in.
RETRO_DIFFUSION_API_KEY=

# Runtime provider. With no Anthropic variables the game uses Codex device OAuth.
DREAMWALKER_CODEX_PATH=codex
DREAMWALKER_CODEX_HOME=.dreamwalker/codex-home
# DREAMWALKER_SECRET_FILE=/absolute/path/to/dreams/<slug>/secret.local.txt
# DREAMWALKER_AI_VERBOSE=1

# Alternative Anthropic Messages-compatible proxy. Set all three to bypass Codex OAuth.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
